DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ALLOWED_ORIGINS=["http://localhost:5183","http://localhost:5184"]
APP_ENV=development
RESET_DELIVERY_URL=
RESET_DELIVERY_TOKEN=

# Phase 2 server-only AI and private document settings
OPENAI_API_KEY=
AI_CHAT_MODEL=
AI_FAST_MODEL=
AI_EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT=45
AI_MAX_OUTPUT_TOKENS=1800
AI_RETRIEVAL_TOP_K=8
AI_MIN_EVIDENCE_SCORE=0.25
AI_HISTORY_WINDOW=8
AI_DAILY_REQUESTS=50
AI_DAILY_TOKENS=150000
AI_EMBEDDING_BATCH_SIZE=16
AI_MAX_CONTEXT_CHARS=24000
AI_RETENTION_DAYS=365
AI_VECTOR_BACKEND=pgvector
PDF_MAX_BYTES=30000000
PDF_MAX_PAGES=200
PDF_DAILY_UPLOADS=20
PDF_STORAGE_BACKEND=disabled
PDF_LOCAL_ROOT=.private_pdf_storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
INDEXING_WORKER_SECRET=
CRON_SECRET=
INDEXING_LEASE_SECONDS=180
INDEXING_MAX_ATTEMPTS=5
INDEXING_MAX_CONCURRENCY=2

# Phase 3 server-only settings
DATA_ENCRYPTION_KEY=
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Overall chat budget (seconds), independent of individual provider calls
AI_TOTAL_REQUEST_TIMEOUT=35
